---
import Footer from '../components/Footer/Footer.astro';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';

const { title, description, keywords, image, type } = Astro.props;
---

<html lang="es">
  <head>
    <SEO
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      type={type}
    />
    <link rel="preload" href="/fonts/departure-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/courier-prime-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <div class="crt-wrapper">
      <Header />

      <main id="contenido">
        <slot />
      </main>

      <Footer />
    </div>

    <script>
      // Los años salen del build, y el sitio solo se reconstruye cuando hay un
      // push: en enero el número que dejó el build se queda viejo. Se corrige aquí.
      document.querySelectorAll<HTMLElement>('[data-years-since]').forEach((el) => {
        const since = Number(el.dataset.yearsSince);
        if (!Number.isFinite(since)) return;

        const label = el.dataset.yearsLabel ?? '';
        el.textContent = `${new Date().getFullYear() - since}\u00a0${label}`;
      });
    </script>
  </body>
</html>
