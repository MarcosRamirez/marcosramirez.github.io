---
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="navbar">
    <a href="/" class="brand" aria-label="Marcos Ramírez — inicio">
      <b>MARCOS RAMÍREZ</b>
      <span>ingeniero informático</span>
    </a>

    <input
      type="checkbox"
      id="menu-toggle"
      class="menu-toggle"
      aria-label="Abrir menú de navegación"
      aria-controls="nav-menu"
    />
    <label for="menu-toggle" class="menu-icon">[MENÚ]</label>

    <nav id="nav-menu" class="nav-menu" aria-label="Navegación principal">
      <a href="/sobre-mi" class:list={{ active: pathname.startsWith('/sobre-mi') }} aria-current={pathname.startsWith('/sobre-mi') ? 'page' : undefined}>[SOBRE MÍ]</a>
      <a href="/inteligencia-artificial" class:list={{ active: pathname.startsWith('/inteligencia-artificial') }} aria-current={pathname.startsWith('/inteligencia-artificial') ? 'page' : undefined}>[IA]</a>
      <a href="/contacto" class:list={{ active: pathname.startsWith('/contacto') }} aria-current={pathname.startsWith('/contacto') ? 'page' : undefined}>[CONTACTO]</a>
      <a href="/novela-carlos-luis-fallas" class:list={{ active: pathname.startsWith('/novela-carlos-luis-fallas') }} aria-current={pathname.startsWith('/novela-carlos-luis-fallas') ? 'page' : undefined}>[NOVELA]</a>
      <a href="/cumpleanos" class:list={{ active: pathname.startsWith('/cumpleanos') }} aria-current={pathname.startsWith('/cumpleanos') ? 'page' : undefined}>[REGALOS]</a>
      <a href="https://blog.marcosramirez.info" target="_blank" rel="noopener">[BLOG]</a>
      <a href="https://github.com/MarcosRamirez" target="_blank" rel="noopener">[GITHUB]</a>
    </nav>
  </div>
</header>
