---
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="navbar">
    <a href="/" class="brand" aria-label="Marcos Ramírez — inicio">
      <b>MARCOS RAMÍREZ</b>
      <span>ingeniero informático</span>
    </a>

    <input
      type="checkbox"
      id="menu-toggle"
      class="menu-toggle"
      aria-label="Abrir menú de navegación"
      aria-controls="nav-menu"
    />
    <label for="menu-toggle" class="menu-icon">[MENÚ]</label>

    <nav id="nav-menu" class="nav-menu" aria-label="Navegación principal">
      <a href="/sobre-mi" class:list={{ active: pathname.startsWith('/sobre-mi') }} aria-current={pathname.startsWith('/sobre-mi') ? 'page' : undefined}>[SOBRE MÍ]</a>
      <a href="/inteligencia-artificial" class:list={{ active: pathname.startsWith('/inteligencia-artificial') }} aria-current={pathname.startsWith('/inteligencia-artificial') ? 'page' : undefined}>[IA]</a>
      <a href="/contacto" class:list={{ active: pathname.startsWith('/contacto') }} aria-current={pathname.startsWith('/contacto') ? 'page' : undefined}>[CONTACTO]</a>
      <a href="/novela-carlos-luis-fallas" class:list={{ active: pathname.startsWith('/novela-carlos-luis-fallas') }} aria-current={pathname.startsWith('/novela-carlos-luis-fallas') ? 'page' : undefined}>[NOVELA]</a>
      <a href="/cumpleanos" class:list={{ active: pathname.startsWith('/cumpleanos') }} aria-current={pathname.startsWith('/cumpleanos') ? 'page' : undefined}>[REGALOS]</a>
      <a href="https://blog.marcosramirez.info" target="_blank" rel="noopener">[BLOG]</a>
      <a href="https://github.com/MarcosRamirez" target="_blank" rel="noopener">[GITHUB]</a>
      <span class="nav-glow" aria-hidden="true"></span>
    </nav>
  </div>
</header>

<script>
  // Un solo bloque de fósforo que viaja por el menú: descansa en la sección
  // actual y se desliza hasta el enlace con hover o foco. Sin JS se queda el
  // relleno estático de `styles.css`.
  const nav = document.getElementById('nav-menu');
  const glow = nav?.querySelector<HTMLElement>('.nav-glow');

  if (nav && glow) {
    const current = nav.querySelector<HTMLElement>('a[aria-current="page"]');
    let visible = false;

    const moveTo = (link: HTMLElement | null) => {
      if (!link) {
        glow.style.opacity = '0';
        visible = false;
        return;
      }

      // Si estaba apagado, aparece en su sitio en vez de llegar deslizándose.
      if (!visible) glow.classList.add('is-instant');

      glow.style.setProperty('--x', `${link.offsetLeft}px`);
      glow.style.setProperty('--y', `${link.offsetTop}px`);
      glow.style.setProperty('--w', `${link.offsetWidth}px`);
      glow.style.setProperty('--h', `${link.offsetHeight}px`);
      glow.style.opacity = '1';
      visible = true;

      // Forzar el cálculo de estilos para que el salto se aplique sin transición.
      void glow.offsetWidth;
      glow.classList.remove('is-instant');
    };

    const rest = () => {
      visible = false;
      moveTo(current);
    };

    nav.classList.add('is-gliding');
    rest();
    // Las fuentes propias cambian el ancho de las etiquetas al cargar.
    document.fonts?.ready.then(rest);
    window.addEventListener('resize', rest);

    nav.querySelectorAll<HTMLElement>('a').forEach((link) => {
      link.addEventListener('pointerenter', () => moveTo(link));
      link.addEventListener('focus', () => moveTo(link));
    });

    nav.addEventListener('pointerleave', () => moveTo(current));
    nav.addEventListener('focusout', (event) => {
      if (!nav.contains(event.relatedTarget as Node | null)) moveTo(current);
    });
  }
</script>
