---
import { cases } from '../data/cases';

const pathname = Astro.url.pathname.replace(/\/$/, '');
---

<nav class="case-index" aria-label="La lucha por el primer puesto">
  <p class="label">La lucha por el primer puesto</p>
  <ol class="list-rows">
    {cases.map((item) => {
      const current = pathname === item.href;
      return (
        <li class:list={{ 'is-current': current }}>
          <a href={item.href} aria-current={current ? 'page' : undefined}>
            <span class="case-index__n">{item.n}</span>
            <span>{item.title}</span>
          </a>
        </li>
      );
    })}
  </ol>
</nav>
