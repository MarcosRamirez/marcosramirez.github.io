---
const { href, nofollow } = Astro.props;
const local = isLocalURL(href);
const target = local ? "_self" : "_blank";
const rel = [!local && "noopener", nofollow && "nofollow"].filter(Boolean).join(" ") || undefined;

function isLocalURL(url: string) {
  url = String(url);
  return url.startsWith("/") || url.startsWith("#");
}
---

<a href={href} rel={rel} target={target}><slot /></a>
