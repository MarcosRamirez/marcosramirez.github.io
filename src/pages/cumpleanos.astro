---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Regalos de cumpleaños — Marcos Ramírez"
  description="Ideas para hacerme un regalo el 3 de febrero: felicitarme, invitarme a una caña o abrir alguna de mis listas de Amazon."
  keywords="regalos,cumpleaños,marcos ramírez,wishlist"
>
  <div class="page">
    <header class="page__head">
      <p class="label">Anexo <span>A</span> · regalos</p>
      <h1>El 3 de febrero cumplo años</h1>
      <p class="page__lede">
        ¿No sabes qué regalarme? Siete opciones, de una felicitación a una lista de Amazon.
        Ninguna obliga.
      </p>
    </header>

    <ul class="opts">
      <li>
        <a class="opt" data-key="1" href="mailto:marcos@marcosramirez.info?subject=Felicitacion">
          <span class="opt__n">[1]</span>
          <span class="opt__t">Felicitarme</span>
          <span class="opt__k">Gratis</span>
        </a>
      </li>
      <li>
        <a
          class="opt"
          data-key="2"
          href="https://www.paypal.com/donate/?hosted_button_id=ARHMLHJREVJ48"
          target="_blank"
          rel="noopener">
          <span class="opt__n">[2]</span>
          <span class="opt__t">Invitar a una caña</span>
          <span class="opt__k">PayPal</span>
        </a>
      </li>
      <li>
        <a
          class="opt"
          data-key="3"
          href="https://www.amazon.es/hz/wishlist/ls/2ICAR6M2LD175?ref_=wl_share"
          target="_blank"
          rel="noopener">
          <span class="opt__n">[3]</span>
          <span class="opt__t">Libros técnicos</span>
          <span class="opt__k">Amazon</span>
        </a>
      </li>
      <li>
        <a
          class="opt"
          data-key="4"
          href="https://www.amazon.es/hz/wishlist/ls/K1B6A0ERHMI?ref_=wl_share"
          target="_blank"
          rel="noopener">
          <span class="opt__n">[4]</span>
          <span class="opt__t">Montaña</span>
          <span class="opt__k">Amazon</span>
        </a>
      </li>
      <li>
        <a
          class="opt"
          data-key="5"
          href="https://www.amazon.es/hz/wishlist/ls/3W4Z9QV85RRO5?ref_=wl_share"
          target="_blank"
          rel="noopener">
          <span class="opt__n">[5]</span>
          <span class="opt__t">Bici</span>
          <span class="opt__k">Amazon</span>
        </a>
      </li>
      <li>
        <a
          class="opt"
          data-key="6"
          href="https://www.amazon.es/hz/wishlist/ls/2QNS1H3JEUH0V?ref_=wl_share"
          target="_blank"
          rel="noopener">
          <span class="opt__n">[6]</span>
          <span class="opt__t">Ropa</span>
          <span class="opt__k">Amazon</span>
        </a>
      </li>
      <li>
        <a
          class="opt"
          data-key="7"
          href="https://www.amazon.es/hz/wishlist/ls/1S1NVYBRXUSQX?ref_=wl_share"
          target="_blank"
          rel="noopener">
          <span class="opt__n">[7]</span>
          <span class="opt__t">Chorradas</span>
          <span class="opt__k">Amazon</span>
        </a>
      </li>
    </ul>

    <p class="hint">También puedes pulsar 1–7 en el teclado</p>

    <p class="hint" style="margin-top:36px">Gracias por pensar en mí :D</p>
  </div>
</Layout>

<script>
  document.addEventListener('keydown', (event) => {
    if (event.metaKey || event.ctrlKey || event.altKey) return;

    const tag = document.activeElement?.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;

    const target = document.querySelector<HTMLAnchorElement>(`.opt[data-key="${event.key}"]`);
    if (!target) return;

    event.preventDefault();
    target.click();
  });
</script>
