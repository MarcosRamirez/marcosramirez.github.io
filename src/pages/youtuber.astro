---
import Layout from "../layouts/Layout.astro";
import CaseIndex from "../components/CaseIndex.astro";

const description = `Si buscabas a Marcos Ramírez, el youtuber, aquí tienes el enlace a su canal. Soy otro Marcos Ramírez, informático, y él va por delante de mí en Google.`;
---

<Layout
  title="El youtuber — Marcos Ramírez"
  keywords="Marcos Ramírez, Marcos Ramírez youtuber, Marcos Ramírez YouTube, canal de YouTube"
  description={description}
>
  <div class="page">
    <header class="page__head">
      <p class="label">Expediente <span>03</span> · el youtuber</p>
      <h1>Y detrás, un youtuber</h1>
      <p class="page__lede">
        Más de 750.000 seguidores y el mismo nombre que yo. Con esos números, el puesto en
        Google le cayó solo.
      </p>
    </header>

    <div class="page__cols">
      <div class="page__main">
        <section class="sec">
          <h2>Si buscabas su canal</h2>
          <div class="prose">
            <p>
              Está <a href="https://www.youtube.com/channel/UC6XXhLbSsZrUdpWvXW7_4ug" target="_blank" rel="noopener">en YouTube</a>.
              Yo soy otro Marcos Ramírez, informático, y de vídeo sé lo justo.
            </p>
          </div>
        </section>

        <section class="sec">
          <h2>Dónde me defiendo</h2>
          <div class="prose">
            <p>
              En vídeo, en ningún sitio. Escribiendo para la web llevo desde los noventa, y es
              lo único que sé hacer mejor que él.
            </p>
            <p>
              Si te has quedado con curiosidad por el otro Marcos, empieza por
              <a href="/sobre-mi">el ingeniero</a>.
            </p>
          </div>
        </section>
      </div>

      <aside class="page__aside">
        <CaseIndex />
      </aside>
    </div>
  </div>
</Layout>
