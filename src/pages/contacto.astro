---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto — Marcos Ramírez"
  description="Escríbeme por email o reserva una llamada de 30 minutos. Encargos, dudas técnicas y cualquier cosa que no quepa en un formulario."
  keywords="contacto, reuniones, email, marcos ramírez"
>
  <div class="page">
    <header class="page__head">
      <p class="label">Expediente <span>04</span> · contacto</p>
      <h1>Escríbeme, no muerdo</h1>
      <p class="page__lede">
        Para encargos, dudas técnicas o cualquier cosa que no quepa en un formulario. No uso
        redes sociales, así que el email es el camino corto.
      </p>
    </header>

    <div class="page__cols">
      <div>
        <section class="sec">
          <h2>Formulario</h2>

          <form action="https://api.web3forms.com/submit" method="POST" class="form">
            <input type="hidden" name="access_key" value="255f9892-5746-425e-a8a2-acdfdd1d8bab" />
            <input type="hidden" name="redirect" value="https://web3forms.com/success" />

            <div class="field">
              <label for="name">[ NOMBRE ]</label>
              <input type="text" id="name" name="name" autocomplete="name" required />
            </div>

            <div class="field">
              <label for="email">[ EMAIL ]</label>
              <input type="email" id="email" name="email" autocomplete="email" required />
            </div>

            <div class="field">
              <label for="message">[ MENSAJE ]</label>
              <textarea id="message" name="message" rows="6" required></textarea>
            </div>

            <button type="submit">[ ENVIAR ]</button>
          </form>
        </section>

        <section class="sec">
          <h2>O reserva una reunión</h2>
          <p class="prose">
            Treinta minutos por videollamada para lo que necesites contar con más detalle.
          </p>
          <p class="actions">
            <a
              href="#"
              data-cal-link="marcosramirez/en-que-puedo-ayudarte"
              class="btn btn--solid">[ RESERVAR CITA ]</a
            >
          </p>
        </section>
      </div>

      <aside class="page__aside">
        <div>
          <p class="label">Canales</p>
          <dl class="record">
            <div>
              <dt>Email</dt>
              <dd><a href="mailto:marcos@marcosramirez.info">marcos@marcosramirez.info</a></dd>
            </div>
            <div>
              <dt>Agenda</dt>
              <dd>
                <a href="https://cal.com/marcosramirez/en-que-puedo-ayudarte" target="_blank" rel="noopener"
                  >Cal.com · 30 min</a
                >
              </dd>
            </div>
            <div>
              <dt>Redes</dt>
              <dd>Ninguna activa</dd>
            </div>
            <div>
              <dt>Perfiles</dt>
              <dd>
                <a href="https://es.linkedin.com/in/marcosramirezparicio" target="_blank" rel="noopener">LinkedIn</a>
                ·
                <a href="https://github.com/MarcosRamirez" target="_blank" rel="noopener">GitHub</a>
                ·
                <a href="https://blog.marcosramirez.info" target="_blank" rel="noopener">blog</a>
              </dd>
            </div>
          </dl>
        </div>

        <p class="hint">El formulario pasa por web3forms</p>
      </aside>
    </div>
  </div>
</Layout>

<script type="text/javascript" is:inline>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement('script')).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === 'string') {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ['initNamespace', namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  Cal('init', 'en-que-puedo-ayudarte', { origin: 'https://cal.com' });
  Cal.ns['en-que-puedo-ayudarte']('ui', {
    styles: { branding: { brandColor: '#33ff33' } },
    hideEventTypeDetails: false,
    layout: 'month_view',
  });
</script>
